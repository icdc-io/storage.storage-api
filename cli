#!/usr/bin/env python3

import argparse
import json
import os
import sys
import socket
import boto3
import psycopg2
from botocore.client import Config
from botocore.exceptions import (
    EndpointConnectionError,
    NoCredentialsError,
    PartialCredentialsError,
)

# Check required environment variables
REQUIRED_ENV_VARS = [
    "CEPH_ACCESS_KEY",
    "CEPH_SECRET_KEY",
    "CEPH_HOST",
    "DATABASE_HOST",
    "DATABASE_USERNAME",
]

missing_vars = [var for var in REQUIRED_ENV_VARS if not os.environ.get(var)]
if missing_vars:
    print(f"Missing required environment variables: {', '.join(missing_vars)}")
    sys.exit(1)

# Load environment variables
ACCESS_KEY = os.environ["CEPH_ACCESS_KEY"]
SECRET_KEY = os.environ["CEPH_SECRET_KEY"]
CEPH_HOST = os.environ["CEPH_HOST"]
CEPH_PORT = os.environ.get("CEPH_PORT", "80")
DATABASE_HOST = os.environ["DATABASE_HOST"]
DATABASE_PORT = os.environ.get("DATABASE_PORT", "5432")
DATABASE_USERNAME = os.environ["DATABASE_USERNAME"]
DATABASE_PASSWORD = os.environ.get("DATABASE_PASSWORD", "")
DATABASE_NAME = os.environ.get("DATABASE_NAME", "default_db")

# Initialize S3 client
try:
    s3_client = boto3.client(
        "s3",
        endpoint_url=f"http://{CEPH_HOST}:{CEPH_PORT}",
        aws_access_key_id=ACCESS_KEY,
        aws_secret_access_key=SECRET_KEY,
        config=Config(signature_version="s3v4"),
    )
except (EndpointConnectionError, NoCredentialsError, PartialCredentialsError) as e:
    print(f"Error initializing S3 client: {e}")
    sys.exit(1)


def get_ip_from_dns(hostname):
    """
    Resolve the DNS hostname to an IP address.
    :param hostname: The DNS hostname to resolve.
    :return: IP address as a string, or None if resolution fails.
    """
    try:
        return socket.gethostbyname(hostname)
    except socket.gaierror as e:
        print(f"Error resolving hostname '{hostname}': {e}")
        return None


def connect_to_db():
    """Create a connection to the PostgreSQL database."""
    try:
        return psycopg2.connect(
            host=DATABASE_HOST,
            port=DATABASE_PORT,
            user=DATABASE_USERNAME,
            password=DATABASE_PASSWORD,
            database=DATABASE_NAME,
        )
    except Exception as e:
        print(f"Error connecting to the database: {e}")
        sys.exit(1)


def list_buckets():
    """List all S3 buckets."""
    try:
        response = s3_client.list_buckets()
        print("Buckets:")
        for bucket in response.get("Buckets", []):
            print(f"{bucket['Name']}")
        return [bucket["Name"] for bucket in response.get("Buckets", [])]
    except Exception as e:
        print(f"Error listing buckets: {e}")
        return []


def list_objects(bucket_name):
    """List all objects in a given S3 bucket."""
    try:
        response = s3_client.list_objects_v2(Bucket=bucket_name)
        print(f"Contents of bucket '{bucket_name}':")
        if "Contents" in response:
            for obj in response["Contents"]:
                print(f" - {obj['Key']} (Size: {obj['Size']} bytes)")
        else:
            print(" This bucket is empty.")
    except Exception as e:
        print(f"Error listing objects in bucket '{bucket_name}': {e}")


def list_pools():
    """List all pools (S3 and iSCSI)."""
    try:
        connection = connect_to_db()
        cursor = connection.cursor()

        # List S3 pools
        cursor.execute(
            "SELECT id, name FROM pools WHERE type = 's3'"
        )
        s3_pools = cursor.fetchall()
        print("Available S3 pools:")
        if s3_pools:
            for idx, pool in enumerate(s3_pools, start=1):
                print(f"{idx}: {pool[1]} (ID: {pool[0]})")
        else:
            print("No S3 pools available.")

        # List iSCSI pools
        cursor.execute("SELECT id, name FROM pools WHERE type = 'iscsi'")
        iscsi_pools = cursor.fetchall()
        print("\nAvailable iSCSI pools:")
        if iscsi_pools:
            for idx, pool in enumerate(iscsi_pools, start=1):
                print(f"{idx}: {pool[1]} (ID: {pool[0]})")
        else:
            print("No iSCSI pools available.")

        cursor.close()
        connection.close()

    except Exception as e:
        print(f"Error listing pools: {e}")
    finally:
        if "cursor" in locals() and cursor:
            cursor.close()
        if "connection" in locals() and connection:
            connection.close()


def list_accounts():
    """List all accounts from the database."""
    try:
        connection = connect_to_db()
        cursor = connection.cursor()

        cursor.execute("SELECT id, name FROM accounts")
        accounts = cursor.fetchall()

        print("Accounts:")
        if accounts:
            for idx, account in enumerate(accounts, start=1):
                print(f"{idx}: {account[1]} (ID: {account[0]})")
        else:
            print("No accounts found.")

        cursor.close()
        connection.close()
    except Exception as e:
        print(f"Error listing accounts: {e}")
    finally:
        if "cursor" in locals() and cursor:
            cursor.close()
        if "connection" in locals() and connection:
            connection.close()


def parse_bucket_and_object(path):
    """
    Parse a bucket/object path into bucket and object_key.
    Returns (bucket, object_key) or (None, None) if the format is invalid.
    """
    parts = path.split("/", 1)
    if len(parts) != 2 or not parts[0] or not parts[1]:
        return None, None
    return parts[0], parts[1]


def show_object(bucket, object_key):
    """
    Show the contents of a specific object in JSON format.
    Example usage: ./cli --show-object BUCKET/OBJECT
    """
    try:
        response = s3_client.get_object(Bucket=bucket, Key=object_key)
        data = response["Body"].read().decode("utf-8")
        try:
            json_data = json.loads(data)
            print(json.dumps(json_data, indent=4))
        except json.JSONDecodeError:
            print(f"Object content is not valid JSON. Showing raw content:\n{data}")
    except Exception as e:
        print(f"Error fetching object '{object_key}' from bucket '{bucket}': {e}")


def show_acc(acc):
    """
    Show the contents of the S3 and iSCSI objects in a combined JSON format.
    Example: ./cli --show-acc acc1
    This will fetch data from storage-db/s3/acc1 and storage-db/iscsi/acc1.
    """
    paths = {"s3": f"storage-db/s3/{acc}", "iscsi": f"storage-db/iscsi/{acc}"}

    combined_data = {"account": acc, "s3": None, "iscsi": None}

    for key, path in paths.items():
        bucket, object_key = parse_bucket_and_object(path)
        if not bucket or not object_key:
            print(f"Invalid format for path: {path}")
            continue

        try:
            response = s3_client.get_object(Bucket=bucket, Key=object_key)
            data = response["Body"].read().decode("utf-8")
            try:
                json_data = json.loads(data)
                combined_data[key] = json_data
            except json.JSONDecodeError:
                print(f"Object content is not valid JSON. Skipping '{path}':\n{data}")
        except Exception as e:
            print(f"Error fetching object '{object_key}' from bucket '{bucket}': {e}")

    # Pretty-print the combined JSON
    print(json.dumps(combined_data, indent=4))


def insert_account_to_db(
    account_data_for_db, selected_s3_pool, selected_iscsi_pool, cloudgw_name, cloudgw_id
):
    """
    Insert (or update) both S3 and iSCSI account data into the DB,
    including iSCSI gateways from the JSON (iscsi_conf.gateways),
    and now also iSCSI quotas (iscsi_quotas).
    """
    try:
        with psycopg2.connect(
            host=DATABASE_HOST,
            port=DATABASE_PORT,
            user=DATABASE_USERNAME,
            password=DATABASE_PASSWORD,
            database=DATABASE_NAME,
        ) as connection:
            with connection.cursor() as cursor:
                # PART 1: INSERT/UPDATE S3 ACCOUNT + QUOTAS
                account_data_s3 = account_data_for_db.get("s3", {})
                account_name = account_data_s3.get("account")
                account_description = account_data_s3.get(
                    "description", "No description"
                )

                # Quota fields
                account_quota = account_data_s3.get("account_quota", {})
                number_of_objects = account_quota.get("number_of_objects", 0)
                data_size_mb = account_quota.get("data_size_mb", 0)
                number_of_s3users = account_quota.get("number_of_s3users", 0)
                number_of_buckets_per_s3user = account_quota.get(
                    "number_of_buckets_per_s3user", 0
                )

                if not account_name:
                    print(
                        "Account name is required in the JSON data (under 's3.account')."
                    )
                    return

                # Check if the account already exists
                cursor.execute(
                    "SELECT id FROM accounts WHERE name = %s", (account_name,)
                )
                result = cursor.fetchone()

                if result:
                    account_id = result[0]
                    print(
                        f"[S3] Account '{account_name}' already exists (ID={account_id})."
                    )
                else:
                    # Create a new account
                    cursor.execute(
                        """
                        INSERT INTO accounts (name, description)
                        VALUES (%s, %s)
                        RETURNING id
                        """,
                        (account_name, account_description),
                    )
                    account_id = cursor.fetchone()[0]
                    print(
                        f"[S3] New account '{account_name}' created (ID={account_id})."
                    )

                # Check if quota already exists for this account + selected S3 pool
                cursor.execute(
                    "SELECT id FROM s3_quotas WHERE account_id = %s AND pool_id = %s",
                    (account_id, selected_s3_pool),
                )
                quota_exists = cursor.fetchone()

                if quota_exists:
                    print(
                        f"[S3] Quota already exists for account ID={account_id} in pool {selected_s3_pool}."
                    )
                else:
                    # Add S3 quota
                    cursor.execute(
                        """
                        INSERT INTO s3_quotas (objects, data_size_mb, pool_id, account_id, users, buckets)
                        VALUES (%s, %s, %s, %s, %s, %s)
                        """,
                        (
                            number_of_objects,
                            data_size_mb,
                            selected_s3_pool,
                            account_id,
                            number_of_s3users,
                            number_of_buckets_per_s3user,
                        ),
                    )
                    print(
                        f"[S3] S3 quota added for account '{account_name}' (ID={account_id})."
                    )

                # PART 1.5: Insert/Update S3 Users from JSON
                s3users = account_data_s3.get("s3users", [])
                for user_data in s3users:
                    # Filter out users that don't belong to the current account
                    # or the current S3 pool
                    if user_data.get("account") != account_name:
                        continue

                    s3user_name = user_data.get("s3user")
                    s3user_desc = user_data.get("s3user_description", "")
                    s3user_owner = user_data.get("owner", "")
                    if not s3user_name:
                        print("[S3] Skipping a user with empty 's3user' field.")
                        continue

                    # Check if the S3 user already exists
                    db_s3user_name = f"{s3user_name}"

                    # Check if the S3 user already exists
                    cursor.execute(
                        """
                        SELECT id FROM s3_users
                        WHERE name = %s AND account_id = %s
                        """,
                        (db_s3user_name, account_id),
                    )
                    existing_s3user = cursor.fetchone()

                    if existing_s3user:
                        user_id = existing_s3user[0]
                        print(
                            f"[S3-Users] S3 user '{db_s3user_name}' already exists (ID={user_id})."
                        )
                        # Update S3 user info
                        cursor.execute(
                            """
                            UPDATE s3_users
                            SET description = %s,
                                owner = %s
                            WHERE id = %s
                            """,
                            (s3user_desc, s3user_owner, user_id),
                        )
                        print(
                            f"[S3-Users] Updated info for existing S3 user ID={user_id}."
                        )
                    else:
                        # Create a new S3 user
                        cursor.execute(
                            """
                            INSERT INTO s3_users (description, owner, name, account_id, pool_id)
                            VALUES (%s, %s, %s, %s, %s)
                            RETURNING id
                            """,
                            (
                                s3user_desc,
                                s3user_owner,
                                db_s3user_name,
                                account_id,
                                selected_s3_pool,
                            ),
                        )
                        new_user_id = cursor.fetchone()[0]
                        print(
                            f"[S3-Users] Inserted new S3 user '{db_s3user_name}' (ID={new_user_id}) "
                            f"for account '{account_name}'."
                        )

                # PART 2: INSERT/UPDATE iSCSI CONFIG + iSCSI GATEWAYS
                account_data_iscsi = account_data_for_db.get("iscsi", {})
                if account_data_iscsi:
                    iscsi_conf = account_data_iscsi.get("iscsi_conf", {})
                    ceph_pool_name = iscsi_conf.get("ceph_pool")
                    server_iqn = iscsi_conf.get("server_iqn")
                    api_user = iscsi_conf.get("username")
                    api_password = iscsi_conf.get("password")

                    # If missing necessary fields, skip iSCSI insertion
                    if not ceph_pool_name or not server_iqn:
                        print(
                            "[iSCSI] Missing 'ceph_pool' or 'server_iqn'. Skipping iSCSI insertion."
                        )
                    else:
                        iscsi_pool_id_from_db = selected_iscsi_pool
                        iscsi_config_name = f"{account_name}_default.conf"

                        # Check if iSCSI config already exists
                        cursor.execute(
                            """
                            SELECT id
                            FROM iscsi_configs
                            WHERE account_id = %s
                              AND pool_id = %s
                              AND name = %s
                            """,
                            (account_id, iscsi_pool_id_from_db, iscsi_config_name),
                        )
                        iscsi_exists = cursor.fetchone()

                        if iscsi_exists:
                            iscsi_config_id = iscsi_exists[0]
                            print(
                                f"[iSCSI] iSCSI config already exists (ID={iscsi_config_id})."
                            )
                        else:
                            # Insert a new iSCSI config
                            cursor.execute(
                                """
                                INSERT INTO iscsi_configs (pool_id, account_id, name, target_iqn)
                                VALUES (%s, %s, %s, %s)
                                RETURNING id
                                """,
                                (
                                    iscsi_pool_id_from_db,
                                    account_id,
                                    iscsi_config_name,
                                    server_iqn,
                                ),
                            )
                            iscsi_config_id = cursor.fetchone()[0]
                            print(
                                f"[iSCSI] New iSCSI config inserted for '{account_name}' "
                                f"(config ID={iscsi_config_id})."
                            )

                        # Insert or update iSCSI gateways
                        gateways = iscsi_conf.get("gateways", [])
                        if gateways:
                            for gw in gateways:
                                # Match up your JSON fields to the DB columns
                                san_ip = get_ip_from_dns(gw.get("san_ip_address"))  # -> ip_address
                                private_ip = get_ip_from_dns(
                                    gw.get("private_ip_address")
                                )  # -> portal_ip_address

                                if san_ip and private_ip:
                                    # Check if gateway already exists
                                    cursor.execute(
                                        """
                                        SELECT id
                                        FROM iscsi_gateways
                                        WHERE config_id = %s
                                          AND ip_address = %s
                                          AND portal_ip_address = %s
                                        """,
                                        (
                                            iscsi_config_id,
                                            san_ip,
                                            private_ip,
                                        ),
                                    )
                                    existing_gw = cursor.fetchone()

                                    if existing_gw:
                                        print(
                                            f"[iSCSI] Gateway {san_ip} -> {private_ip} "
                                            f"already exists (GW ID={existing_gw[0]})."
                                        )
                                    else:
                                        # Insert a new gateway
                                        cursor.execute(
                                            """
                                            INSERT INTO iscsi_gateways (
                                                config_id,
                                                ip_address,
                                                portal_ip_address,
                                                api_user,
                                                api_password,
                                                name,
                                                cloudgw_id
                                            ) VALUES (%s, %s, %s, %s, %s, %s, %s)
                                            """,
                                            (
                                                iscsi_config_id,
                                                san_ip,
                                                private_ip,
                                                api_user,
                                                api_password,
                                                cloudgw_name,
                                                cloudgw_id,
                                            ),
                                        )
                                        print(
                                            f"[iSCSI] Inserted gateway: "
                                            f"{san_ip} -> {private_ip} (iscsi_config_id={iscsi_config_id})"
                                        )

                    # ----------------------------------------------------------------
                    # PART 2.5: INSERT/UPDATE iSCSI QUOTAS
                    # ----------------------------------------------------------------
                    iscsi_quota = account_data_iscsi.get("account_quota", {})
                    # Extract fields for iscsi_quotas
                    iscsi_storage_size_gb = iscsi_quota.get("storage_size_gb", 0)
                    iscsi_number_of_disks = iscsi_quota.get("number_of_disks", 0)
                    iscsi_number_of_clients = iscsi_quota.get("number_of_clients", 0)

                    # If your DB schema requires snapshots, default to 0 or any integer you prefer
                    snapshots_default = 10

                    # Check if iSCSI quota already exists for this account + selected iSCSI pool
                    cursor.execute(
                        "SELECT id FROM iscsi_quotas WHERE account_id = %s AND pool_id = %s",
                        (account_id, selected_iscsi_pool),
                    )
                    iscsi_quota_exists = cursor.fetchone()

                    if iscsi_quota_exists:
                        print(
                            f"[iSCSI] Quota already exists for account ID={account_id} in iSCSI pool {selected_iscsi_pool}."
                        )
                        # Optionally, update it if you want to keep them in sync:
                        cursor.execute(
                            """
                            UPDATE iscsi_quotas
                            SET clients = %s,
                                disks = %s,
                                data_size_gb = %s,
                                snapshots = %s
                            WHERE account_id = %s AND pool_id = %s
                            """,
                            (
                                iscsi_number_of_clients,
                                iscsi_number_of_disks,
                                iscsi_storage_size_gb,
                                snapshots_default,
                                account_id,
                                selected_iscsi_pool,
                            ),
                        )
                        print(
                            f"[iSCSI] Updated existing iSCSI quota for account ID={account_id}."
                        )
                    else:
                        # Insert new iSCSI quota
                        cursor.execute(
                            """
                            INSERT INTO iscsi_quotas (clients, disks, pool_id, account_id, data_size_gb, snapshots)
                            VALUES (%s, %s, %s, %s, %s, %s)
                            """,
                            (
                                iscsi_number_of_clients,
                                iscsi_number_of_disks,
                                selected_iscsi_pool,
                                account_id,
                                iscsi_storage_size_gb,
                                snapshots_default,
                            ),
                        )
                        print(
                            f"[iSCSI] iSCSI quota added for account '{account_name}' (account ID={account_id})."
                        )

                # Commit all changes
                connection.commit()

    except Exception as e:
        print(f"Error inserting account into the database: {e}")


def migrate_account(acc, s3_pool_id, iscsi_pool_id, cloudgw_name, cloudgw_id):
    """
    Migrate an account to the database:
    1) Reads the account data from S3 (storage-db/s3/acc) & iSCSI (storage-db/iscsi/acc).
    2) Combines them in a single JSON (combined_data).
    3) Passes both to insert_account_to_db for storing in PostgreSQL.
    """
    paths = {"s3": f"storage-db/s3/{acc}", "iscsi": f"storage-db/iscsi/{acc}"}

    combined_data = {"account": acc, "s3": None, "iscsi": None}

    # Fetch data from S3
    for key, path in paths.items():
        bucket, object_key = parse_bucket_and_object(path)
        if not bucket or not object_key:
            print(f"Invalid format for path: {path}")
            continue

        try:
            response = s3_client.get_object(Bucket=bucket, Key=object_key)
            data = response["Body"].read().decode("utf-8")
            try:
                json_data = json.loads(data)
                combined_data[key] = json_data
            except json.JSONDecodeError:
                print(f"Object content is not valid JSON for '{key}'. Skipping.")
        except Exception as e:
            print(f"Error fetching object '{object_key}' from bucket '{bucket}': {e}")

    # Ensure both s3 and iscsi data exist
    if not combined_data["s3"]:
        print(f"S3 data not found for account '{acc}'. Operation aborted.")
        return

    if not combined_data["iscsi"]:
        print(f"iSCSI data not found for account '{acc}'. Operation aborted.")
        return

    print(
        f"Starting migration of account '{acc}' with S3 pool {s3_pool_id}, "
        f"iSCSI pool {iscsi_pool_id}, cloudgw_name '{cloudgw_name}', "
        f"cloudgw_id '{cloudgw_id}'..."
    )
    insert_account_to_db(
        combined_data, s3_pool_id, iscsi_pool_id, cloudgw_name, cloudgw_id
    )


def main():
    parser = argparse.ArgumentParser(
        description="Manage Ceph S3 storage and PostgreSQL."
    )
    parser.add_argument(
        "--list-buckets", action="store_true", help="List all S3 buckets."
    )
    parser.add_argument(
        "--list-objects",
        type=str,
        metavar="BUCKET",
        help="List objects in a specific bucket.",
    )
    parser.add_argument(
        "--show-object",
        type=str,
        metavar="BUCKET/OBJECT",
        help="Show the contents of a specific object (e.g., 'bucket/object').",
    )
    parser.add_argument(
        "--show-acc",
        type=str,
        metavar="ACC",
        help="Show the combined contents of the s3 & iscsi objects for a given account (ACC).",
    )
    parser.add_argument(
        "--list-pools", action="store_true", help="List S3 and iSCSI pools."
    )
    parser.add_argument(
        "--list-accounts",
        action="store_true",
        help="List all accounts from the database.",
    )
    parser.add_argument(
        "--migrate-acc",
        type=str,
        metavar="ACC",
        help="Migrate the specified account (ACC) to the database.",
    )
    parser.add_argument(
        "--s3-pool",
        type=str,
        metavar="POOL_ID",
        help="S3 pool ID for account migration (used with --migrate-acc).",
    )
    parser.add_argument(
        "--iscsi-pool",
        type=str,
        metavar="POOL_ID",
        help="iSCSI pool ID for account migration (used with --migrate-acc).",
    )
    # Add these two new arguments for Cloud Gateway:
    parser.add_argument(
        "--cloudgw_name",
        type=str,
        help="Cloud Gateway name (used with --migrate-acc).",
    )
    parser.add_argument(
        "--cloudgw_id",
        type=str,
        help="Cloud Gateway ID (used with --migrate-acc).",
    )

    args = parser.parse_args()

    if args.list_buckets:
        list_buckets()

    elif args.list_objects:
        list_objects(args.list_objects)

    elif args.show_object:
        bucket, object_key = parse_bucket_and_object(args.show_object)
        if not bucket or not object_key:
            print("Invalid format. Use BUCKET/OBJECT for --show-object.")
        else:
            show_object(bucket, object_key)

    elif args.show_acc:
        show_acc(args.show_acc)

    elif args.list_pools:
        list_pools()

    elif args.list_accounts:
        list_accounts()

    elif args.migrate_acc:
        # Must specify both --s3-pool and --iscsi-pool
        if not args.s3_pool or not args.iscsi_pool:
            print(
                "Error: you must specify both --s3-pool and --iscsi-pool when using --migrate-acc."
            )
            sys.exit(1)

        # Must specify both --cloudgw_name and --cloudgw_id
        if not args.cloudgw_name or not args.cloudgw_id:
            print(
                "Error: you must specify both --cloudgw_name and --cloudgw_id when using --migrate-acc."
            )
            sys.exit(1)

        try:
            s3_pool_id = int(args.s3_pool)
            iscsi_pool_id = int(args.iscsi_pool)
        except ValueError:
            print("Error: --s3-pool and --iscsi-pool must be integers.")
            sys.exit(1)

        migrate_account(
            args.migrate_acc,
            s3_pool_id,
            iscsi_pool_id,
            args.cloudgw_name,
            args.cloudgw_id,
        )

    else:
        print("No valid command provided. Use --help for options.")


if __name__ == "__main__":
    main()
